{
  "name": "controle-de-acesso",
  "version": "1.1.2",
  "description": "",
  "main": "main.js",
  "scripts": {     
    "prestart": "npm run rebuild",
    "start": "electron .",
    "dev": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.itallian.controledeacesso",
    "productName": "Controle de Acesso",
    "asar": true,
    "compression": "maximum",  
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "../Compilado"
    },
    "win": {
      "target": "portable"
    }
  },
  "author": "Olavo Tomaz",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "exceljs": "^4.4.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1"
  }
}
